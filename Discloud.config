# Конфигурация развёртывания на Discloud.app
# Документация: https://docs.discloud.app/resources/app/configuration
#
# APPTYPE = bot | website | public
# Для Discord-бота всегда "bot" — Discloud держит websocket-соединение постоянно.

APPTYPE=bot
APPTITLE=Soul-bot
APPDIR=.
MAIN=bot.py
RAM=512
VERSION=latest
AUTORESTART=true
