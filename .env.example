# === Discord ===
DISCORD_TOKEN=YOUR_BOT_TOKEN
GUILD_ID=YOUR_SERVER_ID

# === Каналы ===
# Канал с панелью "Создать заявку"
AFK_CHANNEL_ID=YOUR_AFK_CHANNEL_ID
# Канал, куда бот отправляет новые заявки для модераторов
AFK_REVIEW_CHANNEL_ID=YOUR_REVIEW_CHANNEL_ID
# Канал логов (📜・afk-logs)
AFK_LOG_CHANNEL_ID=YOUR_LOG_CHANNEL_ID
# Канал таблицы активных АФК (📋・afk-status)
AFK_STATUS_CHANNEL_ID=YOUR_STATUS_CHANNEL_ID

# === Роли ===
AFK_ROLE_ID=YOUR_AFK_ROLE_ID
# Роли, которым разрешено принимать/отклонять заявки (через запятую)
AFK_REVIEW_ROLE_IDS=123456789,987654321
# Опционально: отдельные роли администратора и модератора
ADMIN_ROLE_ID=
MODERATOR_ROLE_ID=

# === Soul-Coins ===
# Канал «Таблица баллов» (создаётся таблица и кнопки +/−)
SOUL_COIN_TABLE_CHANNEL_ID=YOUR_TABLE_CHANNEL_ID
# Админ-чат «лог-баллов» (логи начислений, предупреждения, отчёт по норме)
SOUL_COIN_LOG_CHANNEL_ID=YOUR_LOG_CHANNEL_ID
# Роль Leader — участники с ней (и с ADMIN_ROLE_ID) не попадают в таблицу
LEADER_ROLE_ID=YOUR_LEADER_ROLE_ID
# Минимальная норма Soul-Coins в месяц
SOUL_COIN_NORM=60
# Единственная роль, выдаваемая при ежемесячном сокращении
SOUL_COIN_REDUCED_ROLE_ID=YOUR_REDUCED_ROLE_ID
# За сколько дней до конца месяца слать предупреждения о невыполненной норме
SOUL_COIN_WARNING_DAYS=7

# === Верификация ===
# Канал «✅│верификация» — закреплённое сообщение с кнопкой «Верифицироваться»
VERIFY_CHANNEL_ID=YOUR_VERIFY_CHANNEL_ID
# Роль «✅ Верифицирован», выдаваемая после анкеты
VERIFY_ROLE_ID=YOUR_VERIFY_ROLE_ID
# Админ-чат — сюда пишется лог каждой верификации
VERIFY_LOG_CHANNEL_ID=YOUR_ADMIN_LOG_CHANNEL_ID
# Префикс в никнейме новичка: "Verf. Имя в игре (Имя в жизни)"
VERIFY_NICK_PREFIX=Verf

# === Время ===
# Часовой пояс сервера
TIMEZONE=Europe/Berlin
# Максимальный срок АФК в днях
MAX_AFK_DAYS=30
# Минимальный срок АФК в минутах
MIN_AFK_MINUTES=30
# Как часто scheduler проверяет завершённые АФК (в секундах)
CHECK_INTERVAL_SECONDS=60

# === Команды ===
# true  — глобальная регистрация slash-команд (обновляется медленнее)
# false — регистрация только на сервере GUILD_ID (рекомендуется при разработке)
SYNC_GLOBALLY=false
